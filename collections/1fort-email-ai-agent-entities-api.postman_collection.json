          "name": "Search All Entities",
          "request": {
            "name": "Search All Entities",
            "description": {
              "content": "\nSearch across all entity types for a profile's linked business.\n\n**Requires**: Profile must be linked to a business.\n\n**Filters**: Django ORM-style filters supported:\n- Exact match: `{\"status\": \"ACTIVE\"}`\n- In list: `{\"status__in\": [\"ACTIVE\", \"PENDING\"]}`\n- Date range: `{\"effective_date__gte\": \"2025-01-01\", \"effective_date__lte\": \"2025-12-31\"}`\n- Greater/less than: `{\"premium__gt\": 10000}`\n- Case-insensitive: `{\"quote_number__iexact\": \"Q123\"}`\n- Contains: `{\"policy_number__icontains\": \"POL\"}`\n\n**Entity Types**: coverage_applications, quotes, policies, invoices, binders, cois\n\n**Authentication**: Requires API Key + Session Token\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "broker",
                "agent",
                "profiles",
                ":profile_pk",
                "entities",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "profile_pk",
                  "description": "(Required) Profile ID (opensearch_profile_id)"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Processing session token (scopes access to broker)",
                "key": "X-Processing-Session",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filters\": {},\n  \"entity_types\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"limit\": 20,\n  \"offset\": 0,\n  \"order_by\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
