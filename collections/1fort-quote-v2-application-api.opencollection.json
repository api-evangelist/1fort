                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Only returns tasks with visible_to_business=True from the most recently created task group.\nThis endpoint can be accessed by both broker users and business users.\n\nIt supports filtering by either quote_id or application_id."
