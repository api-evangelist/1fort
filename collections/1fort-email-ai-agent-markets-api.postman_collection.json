        {
          "id": "b0f3f348-c308-486c-acc2-7849d7597b23",
          "name": "Log Market Transaction",
          "request": {
            "name": "Log Market Transaction",
            "description": {
              "content": "\nRecord a single agent-driven `markets/upsert` attempt (success or failure).\n\n- On success, `market_id` is required and `error_code`/`error_message` must be omitted.\n- On failure, `error_code` and `error_message` are required and `market_id` must be omitted.\n\nBoth `email_id` and `market_id` (when present) must belong to the session broker.\n\n**Authentication**: Requires API Key + Session Token\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "broker",
                "agent",
                "markets",
                "transactions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Processing session token (scopes access to broker)",
                "key": "X-Processing-Session",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email_id\": \"<uuid>\",\n  \"status\": \"<string>\",\n  \"market_id\": \"<string,null-uuid>\",\n  \"request_payload\": \"<string>\",\n  \"response_payload\": \"<string>\",\n  \"error_code\": \"<string>\",\n  \"error_message\": \"<string>\",\n  \"attempted_at\": \"<dateTime>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
