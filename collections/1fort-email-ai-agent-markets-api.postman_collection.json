        {
          "id": "ca337c4b-20cd-41c0-a1c6-e8c855acdb7a",
          "name": "Upsert Market",
          "request": {
            "name": "Upsert Market",
            "description": {
              "content": "\nCreate or update a broker market for the session broker matched by `(carrier, wholesaler, product_lines)`.\n\nAt least one of `carrier` or `wholesaler` must be provided. `product_lines` must be non-empty.\n\nIf no existing market for the session broker matches the key exactly, a new one is created\nand `201 Created` is returned. If exactly one match is found, it is updated and `200 OK` is\nreturned with the same `id`.\n\nIf multiple rows match the key (data anomaly), `400 Bad Request` is returned — use\n`PATCH /markets/{id}` to resolve.\n\n**Authentication**: Requires API Key + Session Token\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "broker",
                "agent",
                "markets",
                "upsert"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Processing session token (scopes access to broker)",
                "key": "X-Processing-Session",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_lines\": [\n    \"<uuid>\",\n    \"<uuid>\"\n  ],\n  \"carrier\": \"<string,null-uuid>\",\n  \"wholesaler\": \"<string,null-uuid>\",\n  \"sub_product_lines\": [\n    \"<uuid>\",\n    \"<uuid>\"\n  ],\n  \"herald_products\": [\n    \"<uuid>\",\n    \"<uuid>\"\n  ],\n  \"submission_method\": \"<string>\",\n  \"agency_code\": \"<string,null>\",\n  \"am_best_rating\": \"<string>\",\n  \"commission_percentage\": \"<string,null-decimal>\",\n  \"renewal_commission_percentage\": \"<string,null-decimal>\",\n  \"filing_type\": \"<string>\",\n  \"billing_type\": \"<string>\",\n  \"eta_hours\": \"<integer,null>\",\n  \"underwriter_emails\": \"<string>\",\n  \"remittance_emails\": \"<string>\",\n  \"bank_routing_number\": \"<string,null>\",\n  \"bank_account_number\": \"<string,null>\",\n  \"is_active\": \"<boolean>\",\n  \"special_notes\": \"<string>\",\n  \"restrictions\": \"<string>\",\n  \"source\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
