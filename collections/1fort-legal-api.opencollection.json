{
  "opencollection": "1.0.0",
  "info": {
    "name": "1Fort API Documentation Legal API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "legal",
        "type": "folder"
      },
      "items": [
