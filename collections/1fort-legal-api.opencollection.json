              }
            ]
          },
          "docs": "Read-only API for platform legal documents with per-user signing."
        },
        {
          "info": {
            "name": "Sign",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.1fort.com/apis/legal-documents/:document_type/sign",
            "params": [
              {
                "name": "document_type",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Read-only API for platform legal documents with per-user signing."
        }
      ]
    }
  ],
  "bundled": true
