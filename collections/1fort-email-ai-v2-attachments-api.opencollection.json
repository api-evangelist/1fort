                "value": "",
                "type": "path",
                "description": "A UUID string identifying this Email Attachment."
              }
            ]
          },
          "docs": "Retrieve attachment details"
        },
        {
          "info": {
            "name": "Download",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.1fort.com/apis/v2/broker/:business_id/attachments/:id/download",
            "params": [
              {
                "name": "business_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "A UUID string identifying this Email Attachment."
              }
            ]
          },
          "docs": "Download an attachment file"
        }
      ]
    }
  ],
  "bundled": true
