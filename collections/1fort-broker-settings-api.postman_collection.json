          "name": "Verify Domain Authentication",
          "request": {
            "name": "Verify Domain Authentication",
            "description": {
              "content": "\nTrigger DNS verification for the broker agency's domain.\nCalls SendGrid's validate endpoint and updates record statuses.\n\nReturns:\n- success: Whether the API call succeeded\n- all_valid: Whether all DNS records are properly configured\n- records: Updated list of domain authentication records\n- error: Error message if any\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "broker",
                ":broker_pk",
                "domain-authentications",
                "verify"
              ],
              "host": [
                "{{baseUrl}}"
              ],
