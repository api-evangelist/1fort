          "name": "Search Businesses",
          "request": {
            "name": "Search Businesses",
            "description": {
              "content": "\nSearch the broker's businesses for linking to profiles.\n\nAll results are scoped to the session's broker.\n\n**Query Parameters**:\n- `q`: Full-text search query (searches name and domain)\n- `name`: Filter by name (case-insensitive contains)\n- `name__iexact`: Filter by name (exact match)\n- `domain_name`: Filter by domain\n- `has_profiles`: Filter by having linked EmailInsured profiles\n- `limit`: Results limit (default: 20, max: 100)\n- `offset`: Pagination offset\n\n**Authentication**: Requires API Key + Session Token\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "broker",
                "agent",
                "businesses",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "Full-text search query (name, domain)"
