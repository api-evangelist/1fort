                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "Filter by name (case-insensitive contains)"
                },
                {
                  "disabled": false,
                  "key": "name__iexact",
                  "value": "<string>",
                  "description": "Filter by name (exact match)"
                },
                {
                  "disabled": false,
                  "key": "domain_name",
                  "value": "<string>",
                  "description": "Filter by domain"
                },
                {
                  "disabled": false,
                  "key": "has_profiles",
                  "value": "<boolean>",
                  "description": "Filter by having linked profiles"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Results limit (default: 20, max: 100)"
                },
                {
                  "disabled": false,
                  "key": "offset",
