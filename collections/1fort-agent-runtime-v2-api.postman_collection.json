        {
          "id": "ca5a20ae-092d-4297-9a17-3eedc0f07fbc",
          "name": "GET /v2/broker/agent/businesses/find",
          "request": {
            "name": "GET /v2/broker/agent/businesses/find",
            "description": {
              "content": "Broker-scoped business search (NOT profile search), backed by the broker's\nOpenSearch index. The quote runtime uses this to find an existing business\nbefore creating one. Query params (all optional, pass what you have):\n`q`/`name`/`domain_name`/`address` fuzzy-match the name and full address;\n`state` and `postal_code` boost exact matches (postal is the strongest\nsame-business signal); `limit` caps results (default 20, max 100). Returns\n`{count, results: [{id, name, domain_name, addresses}]}` ranked by relevance.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "broker",
                "agent",
                "businesses",
                "find"
