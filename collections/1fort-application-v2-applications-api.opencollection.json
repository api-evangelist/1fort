                "type": "path",
                "description": "A UUID string identifying this Application."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Collects and saves the signature for every coverage application under\nthis application, skipping ones that are already signed.\n\nOne request replaces the old per-coverage collect-signatures fanout;\nthe response carries one result per coverage application. Returns 201\nif any signature was created, 200 if every coverage was already\nsigned, 400 if all attempts failed."
        },
