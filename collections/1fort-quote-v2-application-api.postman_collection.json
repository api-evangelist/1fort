          "id": "b810c5e2-f0c7-4840-9420-976c8632856b",
          "name": "List Visible Tasks for a Business and Quote/Application",
          "request": {
            "name": "List Visible Tasks for a Business and Quote/Application",
            "description": {
              "content": "List all visible quote tasks for a specific business and quote/application (from the latest task groups).\n\nOnly returns tasks with visible_to_business=True.\n\nThis endpoint can be accessed with either a quote_pk or application_pk parameter.\n\nExpandable fields via expand query parameter (comma separated):\n- quote: Full quote details (omits tasks to prevent recursion)\n- business: Business details\n- broker: Broker agency details\n- group: Task group details (omits tasks to prevent recursion)\n- completed_by: Broker user who completed the task\n\nFilters available:\n- status: Filter by task status (todo, done, dismissed, n/a)\n- type: Filter by task type (signature, subjectivities, clarifications)\nExample: ?expand=quote,business,completed_by&type=signature",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "broker",
                ":business_pk",
                "application",
                ":application_pk",
                "visible-tasks"
              ],
              "host": [
                "{{baseUrl}}"
              ],
