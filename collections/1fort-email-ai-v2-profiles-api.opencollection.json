                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Wrapped in @transaction.atomic so that if checkout regeneration\nfails, the invoice/line-item changes are rolled back — preventing\na stale CheckoutInvoice from pointing to updated totals."
        },
