        {
          "info": {
            "name": "Create an insurance invoice with auto-checkout.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.1fort.com/apis/v2/broker/agent/profiles/:profile_pk/invoices",
            "params": [
              {
                "name": "profile_pk",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "If ``herald_quote_id`` is provided, the invoice is built from the\nquote (program/agency fees + CT-derived line items) via\n``InsuranceInvoiceService.create_from_quote``. Set\n``auto_calculate_taxes`` to run InsCipher first so tax fees flow\ninto the invoice. Without ``herald_quote_id``, a standalone invoice\nis created from the supplied line items."
        },
