        {
          "id": "6aedfa3f-c520-4a90-bf01-258f555e651c",
          "name": "Submit Application to Markets (Broker)",
          "request": {
            "name": "Submit Application to Markets (Broker)",
            "description": {
              "content": "\nSubmit an insurance application to one or more markets as a broker.\n\nThis endpoint allows brokers to submit coverage applications to available markets.\nThe submission process will:\n1. Validate the application is ready for submission\n2. Create submission records for each selected market\n3. Trigger quote generation for Herald-enabled markets\n4. Update application status to 'Submitted'\n\nIf no market_ids are provided, the system will automatically select all\navailable markets for the coverage application.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "broker",
                "markets",
                "broker-submit"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"coverage_application_id\": \"<uuid>\",\n  \"market_ids\": [\n    \"<uuid>\",\n    \"<uuid>\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
