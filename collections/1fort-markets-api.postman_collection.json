  "item": [
    {
      "id": "010e2496-3e2b-4b24-976a-2fc27685038f",
      "name": "Markets",
      "description": {
        "content": "**Access:** requires a JWT access token.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "fa9df81e-697e-4dcc-98df-cdf578af8725",
          "name": "Get Available Markets",
          "request": {
            "name": "Get Available Markets",
            "description": {
              "content": "\nRetrieve markets available for submission with advanced filtering options.\n\nThis endpoint returns markets that match the specified criteria. When a\ncoverage_application_id is provided, it returns markets specifically available\nfor that application. Without it, returns all markets accessible to the broker.\n\n**Filtering Options:**\n- Product Line: Filter by product line code(s); comma-separated codes use OR logic\n- Carrier: Filter by insurance carrier\n- Wholesaler: Filter by wholesaler organization\n- Submission Type: Filter by Herald API or Manual submission\n\nMultiple filters can be combined for precise market selection.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "broker",
                "markets",
                "available-markets"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "product_line_code",
                  "value": "<string>",
                  "description": "Filter by product line code(s), case-insensitive. Comma-separated values match markets that include any of the listed product lines (OR), e.g. CYBER,GL,PROP."
                },
                {
                  "disabled": false,
                  "key": "sub_product_line_name",
                  "value": "<string>",
                  "description": "Filter by sub product line name(s). Supports comma-separated list (e.g., 'D&O', 'EP', or 'D&O,EP' for ML)"
                },
                {
                  "disabled": false,
                  "key": "carrier_id",
                  "value": "<uuid>",
                  "description": "Filter by carrier UUID"
                },
                {
                  "disabled": false,
                  "key": "wholesaler_id",
                  "value": "<uuid>",
                  "description": "Filter by wholesaler UUID"
                },
                {
                  "disabled": false,
                  "key": "submission_type",
                  "value": "<string>",
                  "description": "Filter by Market.submission_method: portal (in-portal), manual (email), herald (API)."
                },
                {
                  "disabled": false,
                  "key": "market_type",
                  "value": "<string>",
                  "description": "Distribution channel: ``broker`` = carrier only (no wholesaler/MGA); ``platform`` = wholesaler and/or MGA present."
                },
                {
                  "disabled": false,
                  "key": "admitted",
                  "value": "<boolean>",
                  "description": "Filter by admitted status (true for admitted, false for non-admitted/surplus lines). Only applicable for Herald markets."
                },
                {
                  "disabled": false,
                  "key": "verification",
                  "value": "<string>",
                  "description": "verification"
                },
                {
                  "disabled": false,
                  "key": "billing",
                  "value": "<string>",
                  "description": "billing"
                },
                {
                  "disabled": false,
                  "key": "group_id",
                  "value": "<string>",
                  "description": "group_id"
                },
                {
                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "A search term."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Number of results to return per page."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "The initial index from which to return the results."
                },
                {
                  "disabled": false,
                  "key": "coverage_application_id",
                  "value": "<string>",
                  "description": "Optional. A single coverage-application UUID or a comma-separated list of UUIDs. When provided, the response switches to the grouped-per-id shape (see response schema). When omitted, the broker-wide flat shape is returned."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
