            "name": "Process incoming Office 365 push notification or validation request.",
            "description": {
              "content": "Validation request format (during subscription setup):\nGET with query param: ?validationToken=abc123xyz\n\nNotification payload format:\n{\n    \"value\": [{\n        \"subscriptionId\": \"...\",\n        \"changeType\": \"created\",\n        \"clientState\": \"secretClientValue\",\n        \"resource\": \"Users/{userId}/Messages/{messageId}\",\n        \"resourceData\": {\n            \"@odata.type\": \"#Microsoft.Graph.Message\",\n            \"@odata.id\": \"Users/{userId}/Messages/{messageId}\",\n            \"id\": \"{messageId}\"\n        },\n        \"subscriptionExpirationDateTime\": \"2024-01-04T00:00:00.0000000Z\"\n    }]\n}",
              "type": "text/plain"
            },
