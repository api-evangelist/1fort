        {
          "info": {
            "name": "Public broker user card resolved by agency identifier + broker user ``slug``.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.1fort.com/apis/v2/storefront-agencies/:agency_slug/brokers/:slug",
            "params": [
              {
                "name": "agency_slug",
                "value": "",
                "type": "path"
              },
              {
                "name": "slug",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "``AllowAny`` (API key optional). Response includes contact fields (``email``,\n``phone_number``) for intentional “contact your agent” storefront UI; the\nresource is not listable without both agency context and user slug.\n\nScoped to non-test agencies. Throttled like other public storefront metadata\n(``StoreFrontAgencyPublicThrottle``)."
        },
        {
          "info": {
            "name": "Retrieve Storefront agency",
            "type": "http"
