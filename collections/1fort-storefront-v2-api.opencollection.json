            "url": "https://api.1fort.com/apis/v2/storefront-agencies/:slug",
            "params": [
              {
                "name": "slug",
                "value": "",
                "type": "path",
                "description": "URL-safe identifier derived from domain_name (second-level label). Populated automatically when empty."
              }
            ]
          },
          "docs": "Resolve a broker agency by URL slug (used with agency subdomains on the storefront host)."
        },
