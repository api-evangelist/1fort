          "name": "Paginated ViewSet for retrieving coverages for the broker.",
          "request": {
            "name": "Paginated ViewSet for retrieving coverages for the broker.",
            "description": {
              "content": "Supports Filtering By:\n- insured\n- coverage_type\n- agent (any assigned team member, not just primary)\n- status\n- submission_type\n- effective_date_min (minimum effective date, inclusive)\n- effective_date_max (maximum effective date, inclusive)\n\nSupports Searching By:\n- insured",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "broker",
                "coverages"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "insured",
                  "value": "<string>",
                  "description": "Filter coverages by insured.\n\nExamples:\n- `?insured=Acme Inc.` - Matches coverages with 'Acme Inc.' in insured name\n- `?insured=Acme Inc., Acme Corp.` - Matches coverages with 'Acme Inc.' or 'Acme Corp.' in insured name"
                },
                {
                  "disabled": false,
                  "key": "coverage_type",
                  "value": "<string>",
                  "description": "Filter coverages by coverage type.\n\nExamples:\n- `?coverage_type=CYBER` - Matches coverages with 'CYBER' in coverage type\n- `?coverage_type=CYBER, GENERAL_LIABILITY` - Matches coverages with 'CYBER' or 'GENERAL_LIABILITY' in coverage type"
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter coverages by status.\n\nExamples:\n- `?status=ACTIVE` - Matches coverages with 'ACTIVE' in status\n- `?status=ACTIVE, PENDING` - Matches coverages with 'ACTIVE' or 'PENDING' in status"
                },
                {
                  "disabled": false,
                  "key": "agent",
                  "value": "<string>",
                  "description": "Filter coverages by assigned team member.\n\nExamples:\n- `?agent=123` - Matches coverages where agent id 123 is assigned\n- `?agent=123,456` - Matches coverages where agent id 123 or 456 is assigned"
                },
                {
                  "disabled": false,
                  "key": "submission_type",
                  "value": "<string>",
                  "description": "Filter coverages by submission type. Supports comma-separated values.\n\nAvailable values:\n- `NEW` - New business submissions\n- `RENEWAL` - Renewal submissions\n- `OTHER` - Other submission types\n\nExamples:\n- `?submission_type=NEW` - Matches new business submissions\n- `?submission_type=NEW,RENEWAL` - Matches new or renewal submissions"
                },
                {
                  "disabled": false,
                  "key": "effective_date_min",
                  "value": "<date>",
                  "description": "Filter coverages by minimum effective date (inclusive). Use ISO 8601 date format.\n\nExamples:\n- `?effective_date_min=2024-01-01` - Matches coverages with effective date on or after January 1, 2024\n- `?effective_date_min=2024-01-01&effective_date_max=2024-12-31` - Matches coverages with effective date in 2024"
                },
                {
                  "disabled": false,
                  "key": "effective_date_max",
                  "value": "<date>",
                  "description": "Filter coverages by maximum effective date (inclusive). Use ISO 8601 date format.\n\nExamples:\n- `?effective_date_max=2024-12-31` - Matches coverages with effective date on or before December 31, 2024\n- `?effective_date_min=2024-01-01&effective_date_max=2024-12-31` - Matches coverages with effective date in 2024"
                },
                {
                  "disabled": false,
                  "key": "exclude_source",
                  "value": "<string>",
                  "description": "exclude_source"
                },
                {
                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "A search term."
